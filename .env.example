# Identity shared with the directly exported do.droplets.* metrics.
DROPLET_NAME=mars-demo
DEPLOYMENT_ENVIRONMENT=demo

# OTLP/HTTP logs destination. Include /v1/logs only if your gateway requires it;
# the collector normally appends that path to this base endpoint.
OTLP_ENDPOINT=

# Controlled memory-pressure workload.
WORKING_SET_MB=96
HOLD_MS=5000
MEMORY_BUDGET_MB=192
MAX_INFLIGHT=2
MAX_WAITING=2
QUEUE_TIMEOUT_MS=10000
APP_CONTAINER_MEMORY_LIMIT=384m

# Load test (run from a separate droplet for clean host metrics).
LOAD_HOST=209.38.1.176
LOAD_CONCURRENCY=5
LOAD_DURATION=72h
LOAD_PATH=/work
